# Aurora Group Platform Environment Configuration (v3)

# Server Environment & Port
NODE_ENV=production
PORT=3000

# Session Cryptographic Secret (Replace with a random 64-char string)
SESSION_SECRET=your_super_secret_cryptographic_key_here_change_in_production

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://auroragroup.eg,http://localhost:3000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@aurora-db.2rsgv2b.mongodb.net/aurora?retryWrites=true&w=majority

# Google Sheets Sync URL
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1vr1QTpFCI9KxtTcsszrVAKZoo0CvWHK4KWU_843Rvi4/edit?usp=sharing

# Firebase Service Account Key Path (defaults to ./server/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./server/serviceAccountKey.json
# FIREBASE_PROJECT_ID=aurora-group
# FIREBASE_API_KEY=AIzaSy...

# Transactional SMTP Email (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
