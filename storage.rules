rules_version = '2';

// Proposed Firebase Storage Security Rules for Aurora Group (aurora-group-ae765)
// Note: Media uploads use Cloudinary via the authenticated Vercel API.
// Lock down Firebase Cloud Storage buckets against unauthorized client uploads.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.role in ['super_admin', 'manager', 'employee']
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
